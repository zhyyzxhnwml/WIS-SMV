# ═══════════════════════════════════════════════════════════════
# Caddy 配置（容器内 /etc/caddy/Caddyfile）—— HTTPS 入口
#
#   站点名 = smvsystem（内网名字，不用买域名）
#
#   客户端访问前各做一次，两步：
#     1) hosts 加一行（IP 换成服务器地址）
#          Windows: C:\Windows\System32\drivers\etc\hosts
#          macOS/Linux: /etc/hosts
#          192.168.1.10    smvsystem
#     2) 装一次根证书（不装浏览器会报「证书不受信任」）
#          服务器上导出:
#            docker compose cp web:/data/caddy/pki/authorities/local/root.crt ./root.crt
#          Windows: 双击 root.crt → 安装证书 → 本地计算机 → 受信任的根证书颁发机构
#          macOS:   双击 → 加入「系统」钥匙串 → 设为「始终信任」
#
#   然后访问 https://smvsystem 即可（用名字，别用 IP —— 证书是签给这个名字的）。
#
#   说明：这个证书是 Caddy 内部 CA 签的，只在你装过根证书的机器上被信任，
#   公网上没有任何人认它。以后买了域名（例如 smvsystem.com）就换用文件末尾那段，
#   客户端什么都不用装，浏览器直接绿锁。
# ═══════════════════════════════════════════════════════════════

smvsystem {
	encode gzip

	reverse_proxy app:5000 {
		# 级联检测 / LLM 判定要跑几分钟：Caddy 默认不设读超时（不像 nginx 默认 60s
		# 就把长请求掐断）；前端级联日志要实时输出，所以不缓冲。
		flush_interval -1
	}

	# 强制用 Caddy 内部 CA 签发（不是公网 CA）
	tls internal
}

# ── 买了域名之后换成这段（把域名换成你自己的，并删掉 tls internal）──
# smvsystem.com {
# 	encode gzip
# 	reverse_proxy app:5000 {
# 		flush_interval -1
# 	}
# }
