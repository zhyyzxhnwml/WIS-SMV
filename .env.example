# ═══════════════════════════════════════════════════════════════
# 智海巡航 docker compose 环境变量
# 用法: cp .env.example .env  然后按需修改
# ═══════════════════════════════════════════════════════════════

# ── 数据库 ──
PG_USER=postgres
PG_PASSWORD=wmlwxhn520
PG_DB=postgres

# ── Web ──
SECRET_KEY=change-me-to-a-long-random-string

# ── 默认管理员（全新库首次启动自动播种）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── LLM 模型 ──
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── 向量库 ──
# Milvus（etcd + minio + milvus）已并入 docker-compose.yml，标准部署默认开启。
# on = 使用向量库（法规语义检索 / 轨迹相似召回）；0 = 跳过（法规检索降级为哈希向量）
MILVUS_ENABLE=on

# ── 宿主机端口（本地端口被占用时改这里）──
APP_PORT=5000
PG_HOST_PORT=5432
OLLAMA_HOST_PORT=11434
# 宿主机暴露 Milvus 的端口（容器内部 app 仍走 milvus:19530，本地已有 19530 占用时改这里）
MILVUS_PORT=19530
